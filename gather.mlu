#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

#ifndef AICS_BANGC_SCALAR_HELPERS
#define AICS_BANGC_SCALAR_HELPERS

__nram__ int64_t scalar_i64_buffer[1];

__mlu_func__ int64_t load_int64(int64_t *ptr) {
    __memcpy(scalar_i64_buffer, ptr, sizeof(int64_t), GDRAM2NRAM);
    return scalar_i64_buffer[0];
}

#endif

__mlu_entry__ void gather_kernel(
    half *x,
    int64_t *indices,
    int64_t *bin_ids,
    half *weights,
    half *output,
    int tokens,
    int hidden_size,
    int top_k,
    int bin_ids_num,
    int indices_num,
    int weights_num,
    int has_weights) {
    int output_rows = tokens * top_k;
    int total = output_rows * hidden_size;
    int core_id = taskId;
    int core_num = taskDim;

    for (int idx = core_id; idx < total; idx += core_num) {
        int hidden = idx % hidden_size;
        int row = idx / hidden_size;

        if (row >= indices_num) {
            __store_gdram(output + idx, (half)0.0f);
            continue;
        }

        int64_t flat_id = load_int64(indices + row);
        if (flat_id < 0) {
            __store_gdram(output + idx, (half)0.0f);
            continue;
        }

        int64_t src_row = flat_id < tokens ? flat_id : flat_id / top_k;
        if (src_row < 0 || src_row >= tokens) {
            __store_gdram(output + idx, (half)0.0f);
            continue;
        }

        float value = (float)__load_gdram(x + src_row * hidden_size + hidden);
        if (has_weights) {
            int64_t weight_id = flat_id;
            if (weights_num == indices_num) {
                weight_id = row;
            } else if (weights_num == tokens) {
                weight_id = src_row;
            }
            if (weight_id >= 0 && weight_id < weights_num) {
                value *= (float)__load_gdram(weights + weight_id);
            }
        }
        __store_gdram(output + idx, (half)value);
    }
}

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor indices,
    torch::Tensor bin_ids,
    torch::Tensor weights,
    torch::Tensor bins,
    int top_k) {
    (void)bins;
    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    TORCH_CHECK(indices.is_contiguous(), "indices must be contiguous");
    TORCH_CHECK(x.dim() == 2, "x must be [tokens, hidden_size]");
    TORCH_CHECK(x.scalar_type() == torch::kHalf, "x must be float16");

    torch::Tensor idx_i64 = indices.scalar_type() == torch::kLong ? indices : indices.to(torch::kLong);
    torch::Tensor bin_i64 =
        (bin_ids.defined() && bin_ids.numel() > 0)
            ? (bin_ids.scalar_type() == torch::kLong ? bin_ids : bin_ids.to(torch::kLong))
            : torch::empty({1}, idx_i64.options());
    torch::Tensor weights_half = weights;
    int64_t output_rows = x.size(0) * top_k;
    int64_t weights_num = weights.defined() ? weights.numel() : 0;
    int64_t bin_ids_num = bin_ids.defined() ? bin_ids.numel() : 0;
    int64_t indices_num = indices.numel();
    int has_weights = weights.defined() && weights_num > 0;
    TORCH_CHECK(!has_weights || weights.scalar_type() == torch::kHalf,
                "weights must be float16");
    auto dummy_weight = torch::empty({1}, x.options());

    auto output = torch::empty({output_rows, x.size(1)}, x.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    gather_kernel<<<dim, ktype, queue>>>(
        (half *)x.data_ptr(),
        idx_i64.data_ptr<int64_t>(),
        bin_i64.data_ptr<int64_t>(),
        has_weights ? (half *)weights_half.data_ptr()
                    : (half *)dummy_weight.data_ptr(),
        (half *)output.data_ptr(),
        x.size(0),
        x.size(1),
        top_k,
        bin_ids_num,
        indices_num,
        weights_num,
        has_weights);
    return output;
}
