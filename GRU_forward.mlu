#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include "bangc_scalar.h"

__mlu_entry__ void gru_forward_kernel(
    float *x,
    float *output,
    int batch,
    int seq_len,
    int input_size,
    int hidden_size,
    int num_layers) {
    if (taskId != 0) {
        return;
    }

    for (int layer = 0; layer < num_layers; ++layer) {
        int layer_input_size = layer == 0 ? input_size : hidden_size;
        for (int b = 0; b < batch; ++b) {
            for (int t = 0; t < seq_len; ++t) {
                for (int h = 0; h < hidden_size; ++h) {
                    float xt = 0.0f;
                    if (h < layer_input_size) {
                        if (layer == 0) {
                            xt = load_float(x + (b * seq_len + t) * input_size + h);
                        } else {
                            xt = load_float(output + (b * seq_len + t) * hidden_size + h);
                        }
                    }

                    float h_prev = 0.0f;
                    if (t > 0) {
                        h_prev = load_float(output + (b * seq_len + (t - 1)) * hidden_size + h);
                    }

                    float z = scalar_sigmoid(xt);
                    float r = scalar_sigmoid(xt + h_prev);
                    float n = scalar_tanh(xt + r * h_prev);
                    store_float(output + (b * seq_len + t) * hidden_size + h,
                                (1.0f - z) * n + z * h_prev);
                }
            }
        }
    }
}

torch::Tensor bang_func(torch::Tensor x, int input_size, int hidden_size, int num_layers) {
    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    TORCH_CHECK(x.dim() == 3, "GRU input must be [batch, seq_len, input_size]");
    TORCH_CHECK(x.size(2) == input_size, "input_size must match input feature dimension");

    torch::Tensor x_fp32 = x.scalar_type() == torch::kFloat ? x : x.to(torch::kFloat);
    auto output = torch::empty({x.size(0), x.size(1), hidden_size}, x_fp32.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {1, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    gru_forward_kernel<<<dim, ktype, queue>>>(
        x_fp32.data_ptr<float>(),
        output.data_ptr<float>(),
        x_fp32.size(0),
        x_fp32.size(1),
        input_size,
        hidden_size,
        num_layers);
    return output;
}
