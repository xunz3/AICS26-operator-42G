#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

__mlu_entry__ void mse_loss_kernel(
    half *predictions,
    half *targets,
    float *output,
    int total) {
    if (taskId != 0) {
        return;
    }

    float sum = 0.0f;
    for (int i = 0; i < total; ++i) {
        float diff = (float)__load_gdram(predictions + i) -
                     (float)__load_gdram(targets + i);
        sum += diff * diff;
    }
    __store_gdram(output, sum / (float)total);
}

torch::Tensor bang_func(torch::Tensor predictions, torch::Tensor targets) {
    TORCH_CHECK(predictions.is_contiguous(), "predictions must be contiguous");
    TORCH_CHECK(targets.is_contiguous(), "targets must be contiguous");
    TORCH_CHECK(predictions.numel() == targets.numel(), "input sizes must match");
    TORCH_CHECK(predictions.scalar_type() == torch::kHalf &&
                    targets.scalar_type() == torch::kHalf,
                "predictions and targets must be float16");

    auto output = torch::empty({}, predictions.options().dtype(torch::kFloat));

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    mse_loss_kernel<<<dim, ktype, queue>>>(
        (half *)predictions.data_ptr(),
        (half *)targets.data_ptr(),
        output.data_ptr<float>(),
        static_cast<int>(predictions.numel()));
    return output;
}
