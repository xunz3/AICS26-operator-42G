#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include "bangc_scalar.h"

__mlu_entry__ void mse_loss_kernel(
    float *predictions,
    float *targets,
    float *output,
    int total) {
    if (taskId != 0) {
        return;
    }

    float sum = 0.0f;
    for (int i = 0; i < total; ++i) {
        float diff = load_float(predictions + i) - load_float(targets + i);
        sum += diff * diff;
    }
    store_float(output, sum / (float)total);
}

torch::Tensor bang_func(torch::Tensor predictions, torch::Tensor targets) {
    TORCH_CHECK(predictions.is_contiguous(), "predictions must be contiguous");
    TORCH_CHECK(targets.is_contiguous(), "targets must be contiguous");
    TORCH_CHECK(predictions.numel() == targets.numel(), "input sizes must match");

    torch::Tensor pred_fp32 = predictions.scalar_type() == torch::kFloat
                                  ? predictions
                                  : predictions.to(torch::kFloat);
    torch::Tensor target_fp32 = targets.scalar_type() == torch::kFloat
                                    ? targets
                                    : targets.to(torch::kFloat);
    auto output = torch::empty({}, pred_fp32.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {1, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    mse_loss_kernel<<<dim, ktype, queue>>>(
        pred_fp32.data_ptr<float>(),
        target_fp32.data_ptr<float>(),
        output.data_ptr<float>(),
        pred_fp32.numel());
    return output;
}
