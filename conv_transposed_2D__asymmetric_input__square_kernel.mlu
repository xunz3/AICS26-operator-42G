#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

__mlu_entry__ void conv_transposed_2d_square_kernel(
    half *x,
    half *weight,
    half *bias,
    half *output,
    int batch,
    int in_channels,
    int h_in,
    int w_in,
    int out_channels,
    int kernel_size,
    int h_out,
    int w_out,
    int stride,
    int padding,
    int groups,
    int has_bias) {
    if (taskId != 0) {
        return;
    }

    int output_total = batch * out_channels * h_out * w_out;
    for (int i = 0; i < output_total; ++i) {
        int oc = (i / (h_out * w_out)) % out_channels;
        __store_gdram(output + i,
                      has_bias ? __load_gdram(bias + oc) : (half)0.0f);
    }

    int in_per_group = in_channels / groups;
    int out_per_group = out_channels / groups;
    for (int b = 0; b < batch; ++b) {
        for (int ic = 0; ic < in_channels; ++ic) {
            int group = ic / in_per_group;
            for (int ih = 0; ih < h_in; ++ih) {
                for (int iw = 0; iw < w_in; ++iw) {
                    float input_value =
                        (float)__load_gdram(x + ((b * in_channels + ic) * h_in + ih) * w_in + iw);
                    for (int ocg = 0; ocg < out_per_group; ++ocg) {
                        int oc = group * out_per_group + ocg;
                        for (int kh = 0; kh < kernel_size; ++kh) {
                            int oh = ih * stride - padding + kh;
                            if (oh < 0 || oh >= h_out) {
                                continue;
                            }
                            for (int kw = 0; kw < kernel_size; ++kw) {
                                int ow = iw * stride - padding + kw;
                                if (ow < 0 || ow >= w_out) {
                                    continue;
                                }
                                int out_offset =
                                    ((b * out_channels + oc) * h_out + oh) * w_out + ow;
                                float updated =
                                    (float)__load_gdram(output + out_offset) +
                                    input_value *
                                        (float)__load_gdram(weight +
                                                            ((ic * out_per_group + ocg) * kernel_size +
                                                             kh) *
                                                                kernel_size +
                                                            kw);
                                __store_gdram(output + out_offset, (half)updated);
                            }
                        }
                    }
                }
            }
        }
    }
}

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor weight,
    int in_channels,
    int out_channels,
    int kernel_size,
    int stride,
    int padding,
    int output_padding,
    int groups,
    bool has_bias) {
    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    TORCH_CHECK(weight.is_contiguous(), "weight must be contiguous");
    TORCH_CHECK(x.scalar_type() == torch::kHalf && weight.scalar_type() == torch::kHalf,
                "x and weight must be float16");
    (void)in_channels;
    (void)out_channels;
    (void)kernel_size;
    (void)has_bias;

    auto dummy_bias = torch::empty({1}, x.options());

    int actual_in_channels = x.size(1);
    int actual_kernel_size = weight.size(2);
    int actual_out_channels = weight.size(1) * groups;
    int h_out = static_cast<int>(
        (x.size(2) - 1) * stride - 2 * padding + actual_kernel_size + output_padding);
    int w_out = static_cast<int>(
        (x.size(3) - 1) * stride - 2 * padding + actual_kernel_size + output_padding);
    auto output = torch::empty({x.size(0), actual_out_channels, h_out, w_out}, x.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    conv_transposed_2d_square_kernel<<<dim, ktype, queue>>>(
        (half *)x.data_ptr(),
        (half *)weight.data_ptr(),
        (half *)dummy_bias.data_ptr(),
        (half *)output.data_ptr(),
        x.size(0),
        actual_in_channels,
        x.size(2),
        x.size(3),
        actual_out_channels,
        actual_kernel_size,
        h_out,
        w_out,
        stride,
        padding,
        groups,
        0);
    return output;
}
