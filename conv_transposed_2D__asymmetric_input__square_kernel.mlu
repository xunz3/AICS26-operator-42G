#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

#define TRANSPOSE_OC_BLOCK 64

__mlu_entry__ void conv_transposed_2d_square_kernel(
    half *x,
    half *weight,
    half *bias,
    float *output,
    int batch,
    int in_channels,
    int h_in,
    int w_in,
    int out_channels,
    int kernel_size,
    int h_out,
    int w_out,
    int stride,
    int padding,
    int groups,
    int has_bias,
    int start_idx,
    int work_count) {
    int core_id = taskId;
    int core_num = taskDim;
    int in_per_group = in_channels / groups;
    int out_per_group = out_channels / groups;
    int oc_blocks_per_group = (out_per_group + TRANSPOSE_OC_BLOCK - 1) / TRANSPOSE_OC_BLOCK;
    __nram__ half weight_half[TRANSPOSE_OC_BLOCK];
    __nram__ float weight_float[TRANSPOSE_OC_BLOCK];
    __nram__ float sum_float[TRANSPOSE_OC_BLOCK];

    for (int local_idx = core_id; local_idx < work_count; local_idx += core_num) {
        int idx = start_idx + local_idx;
        int oc_block = idx % oc_blocks_per_group;
        int group = (idx / oc_blocks_per_group) % groups;
        int spatial = idx / (oc_blocks_per_group * groups);
        int ow = spatial % w_out;
        int oh = (spatial / w_out) % h_out;
        int b = spatial / (h_out * w_out);
        int ocg_base = oc_block * TRANSPOSE_OC_BLOCK;
        int block_len = out_per_group - ocg_base < TRANSPOSE_OC_BLOCK
                            ? out_per_group - ocg_base
                            : TRANSPOSE_OC_BLOCK;
        int aligned_len = (block_len + 63) & ~63;
        int ic_start = group * in_per_group;

        for (int i = 0; i < aligned_len; ++i) {
            sum_float[i] = 0.0f;
        }
        if (has_bias) {
            for (int oc_offset = 0; oc_offset < block_len; ++oc_offset) {
                int oc = group * out_per_group + ocg_base + oc_offset;
                sum_float[oc_offset] = (float)__load_gdram(bias + oc);
            }
        }

        for (int icg = 0; icg < in_per_group; ++icg) {
            int ic = ic_start + icg;
            for (int kh = 0; kh < kernel_size; ++kh) {
                int ih_unstrided = oh + padding - kh;
                if (ih_unstrided < 0 || ih_unstrided % stride != 0) {
                    continue;
                }
                int ih = ih_unstrided / stride;
                if (ih < 0 || ih >= h_in) {
                    continue;
                }
                for (int kw = 0; kw < kernel_size; ++kw) {
                    int iw_unstrided = ow + padding - kw;
                    if (iw_unstrided < 0 || iw_unstrided % stride != 0) {
                        continue;
                    }
                    int iw = iw_unstrided / stride;
                    if (iw < 0 || iw >= w_in) {
                        continue;
                    }
                    float input_value =
                        (float)__load_gdram(x + ((b * in_channels + ic) * h_in + ih) * w_in + iw);
                    for (int oc_offset = 0; oc_offset < block_len; ++oc_offset) {
                        int ocg = ocg_base + oc_offset;
                        weight_half[oc_offset] = __load_gdram(
                            weight + ((ic * out_per_group + ocg) * kernel_size + kh) *
                                         kernel_size +
                                     kw);
                    }
                    __bang_half2float(weight_float, weight_half, aligned_len);
                    __bang_mul_scalar(weight_float, weight_float, input_value, aligned_len);
                    __bang_add(sum_float, sum_float, weight_float, aligned_len);
                }
            }
        }
        for (int oc_offset = 0; oc_offset < block_len; ++oc_offset) {
            int oc = group * out_per_group + ocg_base + oc_offset;
            __store_gdram(output + ((b * out_channels + oc) * h_out + oh) * w_out + ow,
                          sum_float[oc_offset]);
        }
    }
}

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor weight,
    int in_channels,
    int out_channels,
    int kernel_size,
    int stride,
    int padding,
    int output_padding,
    int groups,
    bool has_bias) {
    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    TORCH_CHECK(weight.is_contiguous(), "weight must be contiguous");
    TORCH_CHECK(x.scalar_type() == torch::kHalf && weight.scalar_type() == torch::kHalf,
                "x and weight must be float16");
    (void)in_channels;
    (void)out_channels;
    (void)kernel_size;
    (void)has_bias;

    auto dummy_bias = torch::empty({1}, x.options());

    int actual_in_channels = x.size(1);
    int actual_kernel_size = weight.size(2);
    int actual_out_channels = weight.size(1) * groups;
    int h_out = static_cast<int>(
        (x.size(2) - 1) * stride - 2 * padding + actual_kernel_size + output_padding);
    int w_out = static_cast<int>(
        (x.size(3) - 1) * stride - 2 * padding + actual_kernel_size + output_padding);
    auto output = torch::empty({x.size(0), actual_out_channels, h_out, w_out},
                               x.options().dtype(torch::kFloat));

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {64, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    int out_per_group = actual_out_channels / groups;
    int64_t oc_blocks_per_group =
        (out_per_group + TRANSPOSE_OC_BLOCK - 1) / TRANSPOSE_OC_BLOCK;
    int64_t total = x.size(0) * h_out * w_out * groups * oc_blocks_per_group;
    const int chunk = 1024;
    for (int64_t start = 0; start < total; start += chunk) {
        int work_count = static_cast<int>(
            total - start < chunk ? total - start : chunk);
        conv_transposed_2d_square_kernel<<<dim, ktype, queue>>>(
            (half *)x.data_ptr(),
            (half *)weight.data_ptr(),
            (half *)dummy_bias.data_ptr(),
            (float *)output.data_ptr(),
            x.size(0),
            actual_in_channels,
            x.size(2),
            x.size(3),
            actual_out_channels,
            actual_kernel_size,
            h_out,
            w_out,
            stride,
            padding,
            groups,
            0,
            static_cast<int>(start),
            work_count);
    }
    return output;
}
