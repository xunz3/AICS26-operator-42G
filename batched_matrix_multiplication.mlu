#include <bang.h>
#include <torch/extension.h>
#include <ATen/ops/bmm.h>
#include <cnrt.h>
#include <stdint.h>

#define BMM_CHUNK_SIZE 1024

__mlu_entry__ void batched_matrix_multiplication_kernel(
    half *A,
    half *B,
    half *output,
    int batch,
    int M,
    int K,
    int N) {
    int total = batch * M * N;
    int core_id = taskId;
    int core_num = taskDim;
    __nram__ half nram_a[BMM_CHUNK_SIZE];
    __nram__ half nram_b[BMM_CHUNK_SIZE];
    __nram__ float nram_a_f[BMM_CHUNK_SIZE];
    __nram__ float nram_b_f[BMM_CHUNK_SIZE];
    __nram__ float nram_prod[BMM_CHUNK_SIZE];

    for (int idx = core_id; idx < total; idx += core_num) {
        int n = idx % N;
        int m = (idx / N) % M;
        int b = idx / (M * N);
        float sum = 0.0f;
        int k = 0;
        for (; k + BMM_CHUNK_SIZE <= K; k += BMM_CHUNK_SIZE) {
            __memcpy(nram_a, A + (b * M + m) * K + k,
                     BMM_CHUNK_SIZE * sizeof(half), GDRAM2NRAM);
            for (int kk = 0; kk < BMM_CHUNK_SIZE; ++kk) {
                nram_b[kk] = __load_gdram(B + (b * K + k + kk) * N + n);
            }
            __bang_half2float(nram_a_f, nram_a, BMM_CHUNK_SIZE);
            __bang_half2float(nram_b_f, nram_b, BMM_CHUNK_SIZE);
            __bang_mul(nram_prod, nram_a_f, nram_b_f, BMM_CHUNK_SIZE);
            for (int kk = 0; kk < BMM_CHUNK_SIZE; ++kk) {
                sum += nram_prod[kk];
            }
        }
        for (; k < K; ++k) {
            sum += (float)__load_gdram(A + (b * M + m) * K + k) *
                   (float)__load_gdram(B + (b * K + k) * N + n);
        }
        __store_gdram(output + idx, (half)sum);
    }
}

torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    TORCH_CHECK(A.is_contiguous(), "A must be contiguous");
    TORCH_CHECK(B.is_contiguous(), "B must be contiguous");
    TORCH_CHECK(A.dim() == 3 && B.dim() == 3, "A and B must be 3D tensors");
    TORCH_CHECK(A.size(0) == B.size(0) && A.size(2) == B.size(1), "BMM shape mismatch");
    TORCH_CHECK(A.scalar_type() == torch::kHalf && B.scalar_type() == torch::kHalf,
                "A and B must be float16");

    return at::bmm(A, B);
}
