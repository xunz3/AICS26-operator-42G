#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

#define BMM_N_BLOCK 16

__mlu_entry__ void batched_matrix_multiplication_kernel(
    half *A,
    half *B,
    half *output,
    int batch,
    int M,
    int K,
    int N) {
    int n_blocks = (N + BMM_N_BLOCK - 1) / BMM_N_BLOCK;
    int total = batch * M * n_blocks;
    int core_id = taskId;
    int core_num = taskDim;

    for (int idx = core_id; idx < total; idx += core_num) {
        int nb = idx % n_blocks;
        int m = (idx / n_blocks) % M;
        int b = idx / (M * n_blocks);
        int n_base = nb * BMM_N_BLOCK;
        float sums[BMM_N_BLOCK];
        for (int n = 0; n < BMM_N_BLOCK; ++n) {
            sums[n] = 0.0f;
        }

        for (int k = 0; k < K; ++k) {
            float a_value = (float)__load_gdram(A + (b * M + m) * K + k);
            for (int n = 0; n < BMM_N_BLOCK; ++n) {
                int col = n_base + n;
                if (col < N) {
                    sums[n] +=
                        a_value *
                        (float)__load_gdram(B + (b * K + k) * N + col);
                }
            }
        }
        for (int n = 0; n < BMM_N_BLOCK; ++n) {
            int col = n_base + n;
            if (col < N) {
                __store_gdram(output + (b * M + m) * N + col, (half)sums[n]);
            }
        }
    }
}

torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    TORCH_CHECK(A.is_contiguous(), "A must be contiguous");
    TORCH_CHECK(B.is_contiguous(), "B must be contiguous");
    TORCH_CHECK(A.dim() == 3 && B.dim() == 3, "A and B must be 3D tensors");
    TORCH_CHECK(A.size(0) == B.size(0) && A.size(2) == B.size(1), "BMM shape mismatch");
    TORCH_CHECK(A.scalar_type() == torch::kHalf && B.scalar_type() == torch::kHalf,
                "A and B must be float16");

    auto output = torch::empty({A.size(0), A.size(1), B.size(2)}, A.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {16, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    batched_matrix_multiplication_kernel<<<dim, ktype, queue>>>(
        (half *)A.data_ptr(),
        (half *)B.data_ptr(),
        (half *)output.data_ptr(),
        A.size(0),
        A.size(1),
        A.size(2),
        B.size(2));
    return output;
}
