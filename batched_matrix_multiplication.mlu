#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include "bangc_scalar.h"

__mlu_entry__ void batched_matrix_multiplication_kernel(
    float *A,
    float *B,
    float *output,
    int batch,
    int M,
    int K,
    int N) {
    int total = batch * M * N;
    int core_id = taskId;
    int core_num = taskDim;

    for (int idx = core_id; idx < total; idx += core_num) {
        int n = idx % N;
        int m = (idx / N) % M;
        int b = idx / (M * N);
        float sum = 0.0f;
        for (int k = 0; k < K; ++k) {
            sum += load_float(A + (b * M + m) * K + k) *
                   load_float(B + (b * K + k) * N + n);
        }
        store_float(output + idx, sum);
    }
}

torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    TORCH_CHECK(A.is_contiguous(), "A must be contiguous");
    TORCH_CHECK(B.is_contiguous(), "B must be contiguous");
    TORCH_CHECK(A.dim() == 3 && B.dim() == 3, "A and B must be 3D tensors");
    TORCH_CHECK(A.size(0) == B.size(0) && A.size(2) == B.size(1), "BMM shape mismatch");

    torch::Tensor A_fp32 = A.scalar_type() == torch::kFloat ? A : A.to(torch::kFloat);
    torch::Tensor B_fp32 = B.scalar_type() == torch::kFloat ? B : B.to(torch::kFloat);
    auto output = torch::empty({A.size(0), A.size(1), B.size(2)}, A_fp32.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    batched_matrix_multiplication_kernel<<<dim, ktype, queue>>>(
        A_fp32.data_ptr<float>(),
        B_fp32.data_ptr<float>(),
        output.data_ptr<float>(),
        A_fp32.size(0),
        A_fp32.size(1),
        A_fp32.size(2),
        B_fp32.size(2));
    return output;
}
