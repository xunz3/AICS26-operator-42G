#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

#define CHUNK_SIZE 4096

__mlu_entry__ void leakyrelu_kernel(
    half *input,
    half *output,
    int total,
    float negative_slope) {

    // 多核拆分参数
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;
    uint32_t per_core = total / core_num;
    uint32_t remainder = total % core_num; // 修正笔误

    uint32_t start = core_id * per_core +
                     (core_id < remainder ? core_id : remainder);

    uint32_t count = per_core +
                     (core_id < remainder ? 1 : 0);

    // NRAM
    __nram__ half nram_input_half[CHUNK_SIZE];
    __nram__ half nram_output_half[CHUNK_SIZE];
    __nram__ float nram_input[CHUNK_SIZE];
    __nram__ float nram_relu[CHUNK_SIZE];
    __nram__ float nram_temp[CHUNK_SIZE];

    for (uint32_t offset = 0; offset < count; offset += CHUNK_SIZE) {

        uint32_t len =
            (offset + CHUNK_SIZE <= count)
                ? CHUNK_SIZE
                : (count - offset);

        uint32_t aligned_len = (len + 63) & ~63;

        __memcpy(
            nram_input_half,
            input + start + offset,
            len * sizeof(half),
            GDRAM2NRAM);

        __bang_half2float(
            nram_input,
            nram_input_half,
            aligned_len);

        // relu(x)
        __bang_active_relu(
            nram_relu,
            nram_input,
            aligned_len);

        // min(0,x)
        __bang_sub(
            nram_temp,
            nram_input,
            nram_relu,
            aligned_len);

        // negative_slope * min(0,x)
        __bang_mul_scalar(
            nram_temp,
            nram_temp,
            negative_slope,
            aligned_len);

        // relu + scaled negative
        __bang_add(
            nram_temp,
            nram_relu,
            nram_temp,
            aligned_len);

        __bang_float2half_rn(
            nram_output_half,
            nram_temp,
            aligned_len);

        __memcpy(
            output + start + offset,
            nram_output_half,
            len * sizeof(half),
            NRAM2GDRAM);
    }
}


torch::Tensor bang_func(
    torch::Tensor input,
    double negative_slope) {

    TORCH_CHECK(
        input.is_contiguous(),
        "Input must be contiguous");
    TORCH_CHECK(input.scalar_type() == torch::kHalf, "Input must be float16");

    auto output = torch::empty_like(input);

    int total = input.numel();

    cnrtQueue_t queue =
        torch_mlu::getCurMLUStream();

    cnrtDim3_t dim = {4,1,1};
    cnrtFunctionType_t ktype =
        cnrtFuncTypeUnion1;

    leakyrelu_kernel<<<dim, ktype, queue>>>(
        (half *)input.data_ptr(),
        (half *)output.data_ptr(),
        total,
        (float)negative_slope
    );

    return output;
}
