#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

#define CHUNK_SIZE 4096

__mlu_entry__ void matrix_scalar_multiplication_kernel(
    half *input,
    half *output,
    int total,
    float scalar) {
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;
    uint32_t per_core = total / core_num;
    uint32_t remainder = total % core_num;

    uint32_t start = core_id * per_core +
                     (core_id < remainder ? core_id : remainder);
    uint32_t count = per_core +
                     (core_id < remainder ? 1 : 0);

    __nram__ half nram_input[CHUNK_SIZE];
    __nram__ half nram_output[CHUNK_SIZE];

    for (uint32_t offset = 0; offset < count; offset += CHUNK_SIZE) {
        uint32_t len =
            (offset + CHUNK_SIZE <= count)
                ? CHUNK_SIZE
                : (count - offset);
        uint32_t aligned_len = (len + 63) & ~63;

        __memcpy(
            nram_input,
            input + start + offset,
            len * sizeof(half),
            GDRAM2NRAM);

        __bang_mul_scalar(
            nram_output,
            nram_input,
            (half)scalar,
            aligned_len);

        __memcpy(
            output + start + offset,
            nram_output,
            len * sizeof(half),
            NRAM2GDRAM);
    }
}

torch::Tensor bang_func(torch::Tensor A, double s) {
    TORCH_CHECK(A.is_contiguous(), "A must be contiguous");
    TORCH_CHECK(A.scalar_type() == torch::kHalf, "A must be float16");

    auto output = torch::empty_like(A);

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    matrix_scalar_multiplication_kernel<<<dim, ktype, queue>>>(
        (half *)A.data_ptr(),
        (half *)output.data_ptr(),
        A.numel(),
        static_cast<float>(s));

    return output;
}
