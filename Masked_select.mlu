#include <torch/extension.h>
#include <ATen/ops/masked_select.h>
#include <stdint.h>

torch::Tensor bang_func(torch::Tensor input, torch::Tensor mask) {
    TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
    TORCH_CHECK(mask.is_contiguous(), "mask must be contiguous");
    TORCH_CHECK(mask.numel() == input.numel(), "mask size must match input");
    TORCH_CHECK(input.scalar_type() == torch::kHalf, "input must be float16");
    TORCH_CHECK(mask.scalar_type() == torch::kBool, "mask must be bool");

    return at::masked_select(input, mask);
}
