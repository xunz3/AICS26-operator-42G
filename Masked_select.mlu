#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

#ifndef AICS_BANGC_SCALAR_HELPERS
#define AICS_BANGC_SCALAR_HELPERS

__nram__ int64_t scalar_i64_buffer[1];

__mlu_func__ void store_int64(int64_t *ptr, int64_t value) {
    scalar_i64_buffer[0] = value;
    __memcpy(ptr, scalar_i64_buffer, sizeof(int64_t), NRAM2GDRAM);
}

#endif

__mlu_entry__ void masked_select_kernel(
    half *input,
    half *output,
    int64_t *count,
    int total,
    float threshold) {
    if (taskId != 0) {
        return;
    }

    int64_t out_pos = 0;
    for (int i = 0; i < total; ++i) {
        float value = (float)__load_gdram(input + i);
        if (value > threshold) {
            __store_gdram(output + out_pos, (half)value);
            ++out_pos;
        }
    }
    store_int64(count, out_pos);
}

torch::Tensor bang_func(torch::Tensor input, double threshold) {
    TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
    TORCH_CHECK(input.scalar_type() == torch::kHalf, "input must be float16");

    auto output = torch::empty({input.numel()}, input.options());
    auto count = torch::empty({1}, input.options().dtype(torch::kLong));

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {1, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    masked_select_kernel<<<dim, ktype, queue>>>(
        (half *)input.data_ptr(),
        (half *)output.data_ptr(),
        count.data_ptr<int64_t>(),
        input.numel(),
        static_cast<float>(threshold));

    auto count_cpu = count.to(torch::kCPU);
    int64_t valid = count_cpu.data_ptr<int64_t>()[0];
    return output.narrow(0, 0, valid);
}
