#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <vector>
#include <stdint.h>

__mlu_entry__ void cumsum_kernel(
    half *x,
    half *output,
    int outer,
    int dim_size,
    int inner) {
    int total_lines = outer * inner;
    int core_id = taskId;
    int core_num = taskDim;

    for (int line = core_id; line < total_lines; line += core_num) {
        int outer_idx = line / inner;
        int inner_idx = line % inner;
        float sum = 0.0f;
        for (int d = 0; d < dim_size; ++d) {
            int offset = (outer_idx * dim_size + d) * inner + inner_idx;
            sum += (float)__load_gdram(x + offset);
            __store_gdram(output + offset, (half)sum);
        }
    }
}

torch::Tensor bang_func(torch::Tensor x, int dim) {
    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    if (dim < 0) {
        dim += x.dim();
    }
    TORCH_CHECK(dim >= 0 && dim < x.dim(), "dim out of range");
    TORCH_CHECK(x.scalar_type() == torch::kHalf, "x must be float16");

    auto output = torch::empty_like(x);

    int64_t outer = 1;
    int64_t inner = 1;
    for (int i = 0; i < dim; ++i) {
        outer *= x.size(i);
    }
    for (int i = dim + 1; i < x.dim(); ++i) {
        inner *= x.size(i);
    }

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t kdim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    cumsum_kernel<<<kdim, ktype, queue>>>(
        (half *)x.data_ptr(),
        (half *)output.data_ptr(),
        outer,
        x.size(dim),
        inner);
    return output;
}
