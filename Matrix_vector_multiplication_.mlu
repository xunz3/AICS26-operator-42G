#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

#define MATVEC_CHUNK_SIZE 1024

__mlu_entry__ void matrix_vector_multiplication_kernel(
    half *A,
    half *B,
    half *output,
    int M,
    int K) {
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;
    __nram__ half nram_a[MATVEC_CHUNK_SIZE];
    __nram__ half nram_b[MATVEC_CHUNK_SIZE];
    __nram__ float nram_a_f[MATVEC_CHUNK_SIZE];
    __nram__ float nram_b_f[MATVEC_CHUNK_SIZE];
    __nram__ float nram_prod[MATVEC_CHUNK_SIZE];

    for (int row = core_id; row < M; row += core_num) {
        float sum = 0.0f;
        int k = 0;
        for (; k + MATVEC_CHUNK_SIZE <= K; k += MATVEC_CHUNK_SIZE) {
            __memcpy(nram_a, A + row * K + k,
                     MATVEC_CHUNK_SIZE * sizeof(half), GDRAM2NRAM);
            __memcpy(nram_b, B + k,
                     MATVEC_CHUNK_SIZE * sizeof(half), GDRAM2NRAM);
            __bang_half2float(nram_a_f, nram_a, MATVEC_CHUNK_SIZE);
            __bang_half2float(nram_b_f, nram_b, MATVEC_CHUNK_SIZE);
            __bang_mul(nram_prod, nram_a_f, nram_b_f, MATVEC_CHUNK_SIZE);
            sum += __bang_sum(nram_prod, MATVEC_CHUNK_SIZE);
        }
        for (; k < K; ++k) {
            sum += (float)__load_gdram(A + row * K + k) *
                   (float)__load_gdram(B + k);
        }
        __store_gdram(output + row, (half)sum);
    }
}

torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    TORCH_CHECK(A.is_contiguous(), "A must be contiguous");
    TORCH_CHECK(B.is_contiguous(), "B must be contiguous");
    TORCH_CHECK(A.dim() == 2, "A must be [M, K]");
    TORCH_CHECK(B.numel() == A.size(1), "B must have K elements");
    TORCH_CHECK(A.scalar_type() == torch::kHalf && B.scalar_type() == torch::kHalf,
                "A and B must be float16");

    auto output = torch::empty({A.size(0), 1}, A.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    matrix_vector_multiplication_kernel<<<dim, ktype, queue>>>(
        (half *)A.data_ptr(),
        (half *)B.data_ptr(),
        (half *)output.data_ptr(),
        A.size(0),
        A.size(1));
    return output;
}
