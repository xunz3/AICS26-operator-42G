#include <bang.h>
#include <torch/extension.h>
#include <ATen/ops/conv2d.h>
#include <cnrt.h>
#include <stdint.h>
#include <optional>

__mlu_entry__ void dilated_conv_2d_kernel(
    half *x,
    half *kernel,
    half *output,
    int batch,
    int in_channels,
    int height,
    int width,
    int out_channels,
    int kernel_size,
    int stride,
    int dilation,
    int padding,
    int out_h,
    int out_w) {
    int total = batch * out_channels * out_h * out_w;
    int core_id = taskId;
    int core_num = taskDim;

    for (int idx = core_id; idx < total; idx += core_num) {
        int ow = idx % out_w;
        int oh = (idx / out_w) % out_h;
        int oc = (idx / (out_w * out_h)) % out_channels;
        int b = idx / (out_channels * out_h * out_w);

        float sum = 0.0f;
        for (int ic = 0; ic < in_channels; ++ic) {
            for (int kh = 0; kh < kernel_size; ++kh) {
                int ih = oh * stride - padding + kh * dilation;
                if (ih < 0 || ih >= height) {
                    continue;
                }
                for (int kw = 0; kw < kernel_size; ++kw) {
                    int iw = ow * stride - padding + kw * dilation;
                    if (iw < 0 || iw >= width) {
                        continue;
                    }
                    sum +=
                        (float)__load_gdram(x + ((b * in_channels + ic) * height + ih) * width + iw) *
                        (float)__load_gdram(kernel +
                                            ((oc * in_channels + ic) * kernel_size + kh) * kernel_size +
                                                kw);
                }
            }
        }
        __store_gdram(output + idx, (half)sum);
    }
}

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int dilation,
    int padding) {
    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    TORCH_CHECK(kernel.is_contiguous(), "kernel must be contiguous");
    TORCH_CHECK(x.scalar_type() == torch::kHalf && kernel.scalar_type() == torch::kHalf,
                "x and kernel must be float16");

    (void)in_channels;
    (void)out_channels;
    (void)kernel_size;
    return at::conv2d(
        x,
        kernel,
        std::nullopt,
        {1, 1},
        {padding, padding},
        {dilation, dilation},
        1);
}
