#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

__mlu_entry__ void average_pooling_2d_kernel(
    half *x,
    half *output,
    int batch,
    int channels,
    int height,
    int width,
    int out_h,
    int out_w,
    int kernel_size,
    int stride,
    int padding) {
    int total = batch * channels * out_h * out_w;
    int core_id = taskId;
    int core_num = taskDim;
    float denom = (float)(kernel_size * kernel_size);

    for (int idx = core_id; idx < total; idx += core_num) {
        int ow = idx % out_w;
        int oh = (idx / out_w) % out_h;
        int c = (idx / (out_w * out_h)) % channels;
        int b = idx / (channels * out_h * out_w);

        float sum = 0.0f;
        int h_start = oh * stride - padding;
        int w_start = ow * stride - padding;
        for (int kh = 0; kh < kernel_size; ++kh) {
            int ih = h_start + kh;
            if (ih < 0 || ih >= height) {
                continue;
            }
            for (int kw = 0; kw < kernel_size; ++kw) {
                int iw = w_start + kw;
                if (iw < 0 || iw >= width) {
                    continue;
                }
                sum += (float)__load_gdram(x + ((b * channels + c) * height + ih) * width + iw);
            }
        }
        __store_gdram(output + idx, (half)(sum / denom));
    }
}

torch::Tensor bang_func(
    torch::Tensor x,
    int kernel_size) {
    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    TORCH_CHECK(x.dim() == 4, "x must be [batch, channels, height, width]");
    TORCH_CHECK(x.scalar_type() == torch::kHalf, "x must be float16");

    int stride = kernel_size;
    int padding = 0;
    int64_t out_h = (x.size(2) + 2 * padding - kernel_size) / stride + 1;
    int64_t out_w = (x.size(3) + 2 * padding - kernel_size) / stride + 1;
    auto output = torch::empty({x.size(0), x.size(1), out_h, out_w}, x.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    average_pooling_2d_kernel<<<dim, ktype, queue>>>(
        (half *)x.data_ptr(),
        (half *)output.data_ptr(),
        x.size(0),
        x.size(1),
        x.size(2),
        x.size(3),
        out_h,
        out_w,
        kernel_size,
        stride,
        padding);
    return output;
}
