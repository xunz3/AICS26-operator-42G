#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <vector>
#include <stdint.h>

#ifndef AICS_BANGC_SCALAR_HELPERS
#define AICS_BANGC_SCALAR_HELPERS

__nram__ int64_t scalar_i64_buffer[1];

__mlu_func__ int64_t load_int64(int64_t *ptr) {
    __memcpy(scalar_i64_buffer, ptr, sizeof(int64_t), GDRAM2NRAM);
    return scalar_i64_buffer[0];
}

__mlu_func__ void store_int64(int64_t *ptr, int64_t value) {
    scalar_i64_buffer[0] = value;
    __memcpy(ptr, scalar_i64_buffer, sizeof(int64_t), NRAM2GDRAM);
}

#endif

__mlu_entry__ void topk_kernel(
    half *x,
    half *values,
    int64_t *indices,
    int rows,
    int cols,
    int k,
    int dim) {
    int core_id = taskId;
    int core_num = taskDim;

    if (dim == 1 || dim == -1) {
        for (int row = core_id; row < rows; row += core_num) {
            for (int out = 0; out < k; ++out) {
                float best = -3.402823466e+38f;
                int64_t best_idx = 0;
                for (int c = 0; c < cols; ++c) {
                    float value = (float)__load_gdram(x + row * cols + c);
                    bool used = false;
                    for (int prev = 0; prev < out; ++prev) {
                        if (load_int64(indices + row * k + prev) == c) {
                            used = true;
                        }
                    }
                    if (!used && value > best) {
                        best = value;
                        best_idx = c;
                    }
                }
                __store_gdram(values + row * k + out, (half)best);
                store_int64(indices + row * k + out, best_idx);
            }
        }
    } else {
        for (int col = core_id; col < cols; col += core_num) {
            for (int out = 0; out < k; ++out) {
                float best = -3.402823466e+38f;
                int64_t best_idx = 0;
                for (int r = 0; r < rows; ++r) {
                    float value = (float)__load_gdram(x + r * cols + col);
                    bool used = false;
                    for (int prev = 0; prev < out; ++prev) {
                        if (load_int64(indices + prev * cols + col) == r) {
                            used = true;
                        }
                    }
                    if (!used && value > best) {
                        best = value;
                        best_idx = r;
                    }
                }
                __store_gdram(values + out * cols + col, (half)best);
                store_int64(indices + out * cols + col, best_idx);
            }
        }
    }
}

std::vector<torch::Tensor> bang_func(torch::Tensor x, int k, int dim) {
    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    TORCH_CHECK(x.dim() == 2, "x must be [batch, dim]");
    if (dim < 0) {
        dim += x.dim();
    }
    TORCH_CHECK(dim == 0 || dim == 1, "dim must be 0 or 1");
    TORCH_CHECK(k >= 0 && k <= x.size(dim), "k out of range");
    TORCH_CHECK(x.scalar_type() == torch::kHalf, "x must be float16");

    std::vector<int64_t> out_shape;
    if (dim == 0) {
        out_shape = {k, x.size(1)};
    } else {
        out_shape = {x.size(0), k};
    }
    auto values = torch::empty(out_shape, x.options());
    auto indices = torch::empty(out_shape, x.options().dtype(torch::kLong));

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t kdim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    topk_kernel<<<kdim, ktype, queue>>>(
        (half *)x.data_ptr(),
        (half *)values.data_ptr(),
        indices.data_ptr<int64_t>(),
        x.size(0),
        x.size(1),
        k,
        dim);
    return {values, indices};
}
