#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

__mlu_entry__ void conv_standard_1d_kernel(
    half *x,
    half *weight,
    half *bias,
    half *output,
    int batch,
    int in_channels,
    int length,
    int out_channels,
    int kernel_size,
    int out_length,
    int stride,
    int padding,
    int dilation,
    int groups,
    int has_bias) {
    int total = batch * out_channels * out_length;
    int core_id = taskId;
    int core_num = taskDim;
    int in_per_group = in_channels / groups;
    int out_per_group = out_channels / groups;

    for (int idx = core_id; idx < total; idx += core_num) {
        int ol = idx % out_length;
        int oc = (idx / out_length) % out_channels;
        int b = idx / (out_channels * out_length);
        int group = oc / out_per_group;
        int ic_start = group * in_per_group;
        float sum = has_bias ? (float)__load_gdram(bias + oc) : 0.0f;

        for (int icg = 0; icg < in_per_group; ++icg) {
            int ic = ic_start + icg;
            for (int k = 0; k < kernel_size; ++k) {
                int il = ol * stride - padding + k * dilation;
                if (il >= 0 && il < length) {
                    sum += (float)__load_gdram(x + (b * in_channels + ic) * length + il) *
                           (float)__load_gdram(weight + (oc * in_per_group + icg) * kernel_size + k);
                }
            }
        }
        __store_gdram(output + idx, (half)sum);
    }
}

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor weight,
    int in_channels,
    int out_channels,
    int kernel_size,
    int stride,
    int padding,
    int dilation,
    int groups,
    int has_bias) {
    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    TORCH_CHECK(weight.is_contiguous(), "weight must be contiguous");
    TORCH_CHECK(x.dim() == 3 && weight.dim() == 3, "invalid conv1d shapes");
    TORCH_CHECK(x.scalar_type() == torch::kHalf && weight.scalar_type() == torch::kHalf,
                "x and weight must be float16");
    (void)in_channels;
    (void)out_channels;
    (void)kernel_size;
    (void)has_bias;

    auto dummy_bias = torch::empty({1}, x.options());

    int actual_in_channels = x.size(1);
    int actual_out_channels = weight.size(0);
    int actual_kernel_size = weight.size(2);
    int64_t out_length =
        (x.size(2) + 2 * padding - dilation * (actual_kernel_size - 1) - 1) / stride + 1;
    auto output = torch::empty({x.size(0), actual_out_channels, out_length}, x.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    conv_standard_1d_kernel<<<dim, ktype, queue>>>(
        (half *)x.data_ptr(),
        (half *)weight.data_ptr(),
        (half *)dummy_bias.data_ptr(),
        (half *)output.data_ptr(),
        x.size(0),
        actual_in_channels,
        x.size(2),
        actual_out_channels,
        actual_kernel_size,
        out_length,
        stride,
        padding,
        dilation,
        groups,
        0);
    return output;
}
